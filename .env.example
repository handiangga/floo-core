# PostgreSQL container
POSTGRES_DB=floo_core
POSTGRES_USER=floo_core
POSTGRES_PASSWORD=ganti-dengan-password-database-kuat

# Backend application
PORT=3000
NODE_ENV=production
DB_URL=postgres://floo_core:ganti-dengan-password-database-kuat@postgres:5432/floo_core
DB_SSL=false
REDIS_URL=redis://redis:6379
JWT_SECRET=ganti-dengan-random-secret-panjang

# Keep these while files/PDF still use Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
